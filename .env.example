# ==============================================================================
# Aegis Configuration & Environment Variables (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Server & MCP Transport
AEGIS_SERVER_HOST=0.0.0.0
AEGIS_SERVER_PORT=8000
AEGIS_MCP_ENDPOINT=/mcp
AEGIS_LOG_LEVEL=INFO

# Live AI Backend (Groq Cloud API)
# When GROQ_API_KEY is configured, Groq serves as the primary active backend
# for the agent and numeric guard verification, bypassing AWS Bedrock zero-quota restrictions.
# Multi-Tier Fallback Hierarchy: GROQ -> BEDROCK -> DETERMINISTIC RULE ENGINE.
GROQ_API_KEY=
GROQ_MODEL_ID=llama-3.1-70b-versatile
# Alternative tool-use model: llama3-groq-70b-8192-tool-use-preview

# AWS Region where Amazon Bedrock models or inference profiles are provisioned
# Example values: us-east-1, us-west-2, ap-southeast-2, eu-central-1
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Primary Bedrock Model ID or Cross-Region Inference Profile ID
# Run `python scripts/list_bedrock_models.py` to view available models in your region.
BEDROCK_MODEL_ID=model-id-placeholder

# Optional Fallback Bedrock Model ID
# Used automatically if the primary model hits throttling, access denied, or quota limits.
# If omitted or unavailable, Aegis gracefully falls back to the deterministic rule engine.
BEDROCK_FALLBACK_MODEL_ID=fallback-model-id-placeholder

# Set to 1 only when running live Bedrock tests against real AWS endpoints
# 0 = offline deterministic fallback / mock mode (safe for local development & CI)
AEGIS_LIVE_BEDROCK=0

# SQLite Database Path for Smart Home Device State
AEGIS_DB_PATH=./aegis.db

# Aegis Guard Safety Policies
AEGIS_POLICY_MODE=enforce  # enforce | audit_only | permissive
AEGIS_AUDIT_LOG_PATH=./logs/aegis_audit.jsonl

# Simulated Smart Home Device Settings
SIMULATED_DEVICE_DELAY_MS=0
